/* Generated by Matugen. The imported file preserves your previous glass/layout CSS. */
@import url("./Pywal.theme.pre-matugen-style.css");

:root,
.theme-dark,
.theme-light,
.visual-refresh.theme-dark,
.visual-refresh.theme-light {
    --background-primary: {{ colors.surface.default.hex }} !important;
    --background-secondary: {{ colors.surface_container.default.hex }} !important;
    --background-secondary-alt: {{ colors.surface_container_low.default.hex }} !important;
    --background-tertiary: {{ colors.surface_container_high.default.hex }} !important;
    --background-floating: {{ colors.surface_container_highest.default.hex }} !important;
    --background-accent: {{ colors.primary.default.hex }} !important;
    --background-modifier-hover: {{ colors.on_surface.default.rgba | set_alpha: 0.08 }} !important;
    --background-modifier-active: {{ colors.on_surface.default.rgba | set_alpha: 0.12 }} !important;
    --background-modifier-selected: {{ colors.on_surface.default.rgba | set_alpha: 0.16 }} !important;
    --background-modifier-accent: {{ colors.outline_variant.default.rgba | set_alpha: 0.45 }} !important;

    --text-normal: {{ colors.on_surface.default.hex }} !important;
    --text-muted: {{ colors.on_surface_variant.default.hex }} !important;
    --text-link: {{ colors.primary.default.hex }} !important;
    --text-positive: {{ colors.tertiary.default.hex }} !important;
    --text-warning: {{ colors.secondary.default.hex }} !important;
    --text-danger: {{ colors.error.default.hex }} !important;
    --header-primary: {{ colors.on_surface.default.hex }} !important;
    --header-secondary: {{ colors.on_surface_variant.default.hex }} !important;

    --interactive-normal: {{ colors.on_surface_variant.default.hex }} !important;
    --interactive-hover: {{ colors.on_surface.default.hex }} !important;
    --interactive-active: {{ colors.primary.default.hex }} !important;
    --interactive-muted: {{ colors.outline.default.hex }} !important;

    --brand-500: {{ colors.primary.default.hex }} !important;
    --brand-560: {{ colors.primary.default.hex }} !important;
    --brand-600: {{ colors.primary_container.default.hex }} !important;
    --control-brand-foreground: {{ colors.primary.default.hex }} !important;
    --control-brand-foreground-new: {{ colors.primary.default.hex }} !important;
    --mention-foreground: {{ colors.primary.default.hex }} !important;
    --mention-background: {{ colors.primary.default.rgba | set_alpha: 0.16 }} !important;

    --status-positive: {{ colors.tertiary.default.hex }} !important;
    --status-warning: {{ colors.secondary.default.hex }} !important;
    --status-danger: {{ colors.error.default.hex }} !important;
    --status-speaking: {{ colors.primary.default.hex }} !important;

    --channel-icon: {{ colors.on_surface_variant.default.hex }} !important;
    --channels-default: {{ colors.on_surface_variant.default.hex }} !important;
    --channel-text-area-placeholder: {{ colors.outline.default.hex }} !important;
    --scrollbar-thin-thumb: {{ colors.outline_variant.default.hex }} !important;
    --scrollbar-auto-thumb: {{ colors.outline_variant.default.hex }} !important;
    --scrollbar-auto-track: transparent !important;
}

/* A small direct fallback for newer Discord surfaces that ignore legacy variables. */
body,
#app-mount {
    color: {{ colors.on_surface.default.hex }};
}

::selection {
    background: {{ colors.primary.default.rgba | set_alpha: 0.35 }};
    color: {{ colors.on_primary.default.hex }};
}
