// Example machine-specific Niri profile preserved from the source desktop.

// Keeps input speed, cursor size/theme, layout feel, and output scale stable across profiles.



input {
    keyboard {
        xkb {
            layout "tr"
            options ""
        }
        repeat-rate 70
        repeat-delay 300
    }

    touchpad {
        natural-scroll
        scroll-factor 0.2
    }

    mouse {
        accel-profile "flat"
        accel-speed 0.0
    }

 focus-follows-mouse max-scroll-amount="60%"
    mod-key "Super"
    mod-key-nested "Alt"
}

output "HDMI-A-1" {
    mode "1920x1080@100"
    scale 1
    position x=0 y=0
}

layout {
    background-color "transparent"
    gaps 5
    center-focused-column "never"
    default-column-width { proportion 1.0; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // gaps 5 + struts 5 approximates Hyprland gaps_in=5 / gaps_out=10.
    struts {
        left 5
        right 5
        top 5
        bottom 5
    }

    focus-ring { off; }

    border {
        on
        width 2
        active-color "#c7c2c6"
        inactive-color "#777777"
        urgent-color "#ff4b4b"
    }

    shadow {
        on
        softness 18
        spread 1
        offset x=0 y=4
        color "#000000aa"
    }
}

workspace "1" { open-on-output "HDMI-A-1"; }

workspace "2" { open-on-output "HDMI-A-1"; }

workspace "3" { open-on-output "eDP-1"; }

workspace "4" { open-on-output "eDP-1"; }

workspace "5" { open-on-output "eDP-1"; }

workspace "magic" { open-on-output "eDP-1"; }

cursor {
    xcursor-theme "onymki"
    xcursor-size 24
}

output "eDP-1" {
    mode "1920x1080@144.003"
    scale 1
}

workspace "6" { open-on-output "eDP-1"; }

workspace "7" { open-on-output "eDP-1"; }

workspace "8" { open-on-output "eDP-1"; }

workspace "9" { open-on-output "eDP-1"; }

workspace "10" { open-on-output "eDP-1"; }
