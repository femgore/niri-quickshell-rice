// Optional Steam/game-specific Niri rules.
// Copy selected rules into ~/.config/niri/config.kdl if they match your games.

window-rule {
    match app-id="steam_app_291550"
    min-width 1920
    min-height 1080
}

window-rule {
    match app-id="steam_app_1671210"
    open-floating true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}
